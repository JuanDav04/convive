# Variables SOLO para pruebas. El nombre de la BD debe contener "test":
# las pruebas BORRAN todos los datos y se niegan a correr contra otra base.
DATABASE_URL="postgresql://convive:convive@localhost:5433/convive_test"
NODE_ENV=test
PORT=3001
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=secreto-solo-para-pruebas-automaticas-0123456789
JWT_EXPIRES_IN=1h
UPLOAD_DIR=uploads-test
# 1 MB para poder probar el rechazo por tamaño sin crear archivos enormes
MAX_UPLOAD_MB=1
REINCIDENCE_MIN_CASES=3
REINCIDENCE_WINDOW_DAYS=90
# Límites altos para que las pruebas no se bloqueen entre sí (rate-limit.test.js los baja)
LOGIN_RATE_LIMIT_MAX=100000
API_RATE_LIMIT_MAX=100000

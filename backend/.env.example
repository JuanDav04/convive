# ── Base de datos ──────────────────────────────────────────
DATABASE_URL="postgresql://convive:convive@localhost:5432/convive"

# ── Servidor ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (el dev server de Vite usa 5173)
CORS_ORIGINS=http://localhost:5173

# ── Autenticación ──────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# ── Archivos ───────────────────────────────────────────────
UPLOAD_DIR=uploads
# Build del frontend a servir desde el backend (solo en producción/Render; en local déjalo vacío)
# FRONTEND_DIST=../frontend/dist
MAX_UPLOAD_MB=10

# ── Reincidencia (3 o más casos en los últimos 90 días) ────
REINCIDENCE_MIN_CASES=3
REINCIDENCE_WINDOW_DAYS=90

# ── Límite de peticiones ───────────────────────────────────
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# ── Solo para el seed ──────────────────────────────────────
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_DATA=true
# Solo producción con SEED_DEMO_DATA=true: clave (mín. 8) de los usuarios coordinador y docente
# SEED_DEMO_PASSWORD=
